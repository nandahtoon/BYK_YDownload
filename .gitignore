# pyenv
#   For a library or app, you might want to share this in the repository
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if lockfile mixing occurs, it can be useful to ignore it.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains locked versions, but can be ignored.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains locked versions, but can be ignored.
#pdm.lock

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

